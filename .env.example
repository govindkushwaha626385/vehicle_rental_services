# ---------------------------------------------------------------------------
# Rove — environment configuration
#
# Copy this file to `.env` and fill in real values to run against Supabase.
# With no .env (or VITE_ENABLE_DEMO=true), the app runs entirely in the
# browser using localStorage — no backend required.
# ---------------------------------------------------------------------------

# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Force the local demo mode even when Supabase keys are present.
# Leave false for production.
VITE_ENABLE_DEMO=false

# ---------------------------------------------------------------------------
# Only needed for `npm run seed:users` (a local script using the service role
# key). Never expose the service role key to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Edge Function secrets (set in Supabase, not here):
#   supabase secrets set RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
#   supabase secrets set RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx   ← webhook HMAC key
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxx             ← transaction email (notify fn)
#   supabase secrets set ROVE_FROM_EMAIL=Rove <onboarding@resend.dev>
#   supabase secrets set NOTIFY_SECRET=xxxxxxxxxxxx             ← scheduler → notify auth
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
# ---------------------------------------------------------------------------
